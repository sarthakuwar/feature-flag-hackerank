{
	"name": "featureflag",
	"version": "1.0.0",
	"private": true,
	"description": "Feature Flag App - React and Spring Boot",
	"workspaces": [
		"frontend"
	],
	"scripts": {
		"prestart": "bash setup.sh --start",
		"start": "concurrently \"bun run dev:backend\" \"bun run dev:frontend\"",
		"dev:frontend": "cd frontend && bun run dev",
		"dev:backend": "cd backend && ./gradlew bootRun --args=\"--server.max-http-request-header-size=2MB\" --quiet --console=plain"
	},
	"devDependencies": {
		"concurrently": "9.2.1"
	}
}
