{
	"name": "featureflag",
	"version": "1.0.0",
	"private": true,
	"description": "Feature Flag App - React and Spring Boot",
	"workspaces": [
		"frontend"
	],
	"scripts": {
		"prepare": "bun scripts/install-git-hooks.mjs",
		"docs:check": "bun scripts/docs-check.mjs",
		"prestart": "bash setup.sh --start",
		"start": "concurrently \"bun run dev:backend\" \"bun run dev:frontend\"",
		"dev:frontend": "cd frontend && bun run dev",
		"dev:backend": "bun scripts/dev-backend.mjs"
	},
	"devDependencies": {
		"concurrently": "9.2.1"
	}
}
