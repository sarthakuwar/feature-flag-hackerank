PORT=8000
MONGODB_URI=mongodb://localhost:27017/featureflag_db

# Browser origins allowed by CORS, comma separated.
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# The backend resets and reseeds its database on start, but only for a MongoDB on this machine.
# Set to true to allow it against any other host. This deletes the data there.
FEATUREFLAG_SEED=false

# Optional limits; the values shown are the defaults.
# FEATUREFLAG_STREAM_TIMEOUT_MS=1800000
# FEATUREFLAG_STREAM_MAX_SUBSCRIBERS_PER_ENVIRONMENT=1000
# FEATUREFLAG_STREAM_HEARTBEAT_INTERVAL_MS=15000
# FEATUREFLAG_HTTP_MAX_BODY_BYTES=1048576
# FEATUREFLAG_MONGO_SERVER_SELECTION_TIMEOUT_MS=5000
# FEATUREFLAG_MONGO_CONNECT_TIMEOUT_MS=5000
# FEATUREFLAG_MONGO_SOCKET_TIMEOUT_MS=30000

# Telemetry retention in days; 0 keeps events forever (read by TelemetryIndexInitializer).
# TELEMETRY_RETENTION_DAYS=90

# Capacity of the in-memory queue that batches impression writes; a full queue drops impressions.
# IMPRESSION_QUEUE_CAPACITY=10000
